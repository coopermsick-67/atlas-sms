{
  "name": "atlas-sms",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first wholesale real estate lead CRM and Android SIM SMS bridge",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5"
  }
}
